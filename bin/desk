#!/bin/sh
# Follow symlinks (e.g. ~/bin/desk -> repo/bin/desk) so src/cli.ts is found next to the real file.
self="$0"
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case "$link" in
    /*) self="$link" ;;
    *) self="$(dirname "$self")/$link" ;;
  esac
done
root=$(cd "$(dirname "$self")/.." && pwd -P)
# A checkout runs src/cli.ts; the npm package ships compiled lib/cli.js.
entry="$root/src/cli.ts"
[ -f "$entry" ] || entry="$root/lib/cli.js"
exec node --disable-warning=ExperimentalWarning "$entry" "$@"
